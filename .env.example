# Supabase PostgreSQL connection string.
# Use the pooled connection string for application/runtime queries.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Optional direct connection string for migrations when needed.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Set to false only when local TLS verification fails against your database host.
DATABASE_SSL_REJECT_UNAUTHORIZED="true"

# Auth foundation placeholders. Fill these when authentication is implemented.
AUTH_SECRET="replace-with-a-secure-random-value"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# System user used as the creator for public website reservations.
PUBLIC_BOOKING_CREATED_BY_ID="replace-with-public-website-system-user-id"

# First staff admin seed. Used by `pnpm db:seed`.
SEED_ADMIN_NAME="Hotel Admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-with-a-secure-password"

# Resend demo-request notifications. These values are read on the server only.
RESEND_API_KEY="re_replace-with-your-api-key"
RESEND_FROM_EMAIL="SymplyUp Sales <sales@your-verified-domain.com>"
# Separate multiple sales inboxes with commas, semicolons, or new lines.
RESEND_SALES_RECIPIENTS="sales@example.com, founder@example.com"

# Cloudinary image storage for room and reservation-site images.
CLOUDINARY_CLOUD_NAME="replace-with-cloud-name"
CLOUDINARY_API_KEY="replace-with-api-key"
CLOUDINARY_API_SECRET="replace-with-api-secret"
