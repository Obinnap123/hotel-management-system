generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  RECEPTIONIST
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum RoomStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  MAINTENANCE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
  POS
}

model User {
  id                  String     @id @default(cuid())
  fullName            String
  email               String     @unique
  passwordHash        String
  role                UserRole   @default(RECEPTIONIST)
  status              UserStatus @default(ACTIVE)
  sessionVersion      Int        @default(0)
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  bookingsCreated    Booking[] @relation("BookingCreatedBy")
  bookingsCheckedIn  Booking[] @relation("BookingCheckedInBy")
  bookingsCheckedOut Booking[] @relation("BookingCheckedOutBy")
  paymentsRecorded   Payment[] @relation("PaymentRecordedBy")
}

model RoomType {
  id                    String   @id @default(cuid())
  name                  String   @unique
  slug                  String   @unique
  description           String?
  coverImage            String?
  coverImagePublicId    String?
  galleryImages         String[] @default([])
  galleryImagePublicIds String[] @default([])
  amenities             String[] @default([])
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  rooms Room[]
}

model Room {
  id            String     @id @default(cuid())
  roomNumber    String     @unique
  pricePerNight Decimal    @db.Decimal(12, 2)
  capacity      Int
  status        RoomStatus @default(AVAILABLE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  roomTypeId String
  roomType   RoomType  @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  bookings   Booking[]

  @@index([roomTypeId])
  @@index([status])
}

model Guest {
  id          String   @id @default(cuid())
  fullName    String
  phoneNumber String   @unique
  email       String?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings Booking[]

  @@index([fullName])
}

model Booking {
  id              String        @id @default(cuid())
  checkInDate     DateTime
  checkOutDate    DateTime
  totalAmount     Decimal       @db.Decimal(12, 2)
  guestCount      Int           @default(1)
  specialRequests String?
  checkedInAt     DateTime?
  checkedOutAt    DateTime?
  status          BookingStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  guestId        String
  roomId         String
  createdById    String
  checkedInById  String?
  checkedOutById String?

  guest        Guest    @relation(fields: [guestId], references: [id], onDelete: Restrict)
  room         Room     @relation(fields: [roomId], references: [id], onDelete: Restrict)
  createdBy    User     @relation("BookingCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  checkedInBy  User?    @relation("BookingCheckedInBy", fields: [checkedInById], references: [id], onDelete: Restrict)
  checkedOutBy User?    @relation("BookingCheckedOutBy", fields: [checkedOutById], references: [id], onDelete: Restrict)
  payment      Payment?

  @@index([guestId])
  @@index([roomId])
  @@index([createdById])
  @@index([checkedInById])
  @@index([checkedOutById])
  @@index([status])
  @@index([checkInDate])
  @@index([checkOutDate])
}

model Payment {
  id          String        @id @default(cuid())
  amount      Decimal       @db.Decimal(12, 2)
  method      PaymentMethod
  paymentDate DateTime      @default(now())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  bookingId    String @unique
  recordedById String

  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  recordedBy User    @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([recordedById])
  @@index([paymentDate])
}

model HotelSettings {
  id                  String   @id @default(cuid())
  singletonKey        String   @unique @default("default")
  hotelName           String   @default("Hotel Management")
  phoneNumber         String   @default("")
  emailAddress        String   @default("")
  physicalAddress     String   @default("")
  defaultCheckInTime  String   @default("14:00")
  defaultCheckOutTime String   @default("12:00")
  currency            String   @default("NGN")
  websiteTitle        String   @default("")
  websiteDescription  String   @default("")
  heroImages          String[] @default([])
  heroImagePublicIds  String[] @default([])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model BrandingSettings {
  id                String   @id @default(cuid())
  singletonKey      String   @unique @default("default")
  logoUrl           String?
  logoPublicId      String?
  lightLogoUrl      String?
  lightLogoPublicId String?
  faviconUrl        String?
  faviconPublicId   String?
  primaryColor      String   @default("#173B32")
  accentColor       String   @default("#E5D2A9")
  typographyPreset  String   @default("EDITORIAL")
  colorScheme       String   @default("LIGHT")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model WebsiteContent {
  id                    String             @id @default(cuid())
  singletonKey          String             @unique @default("default")
  websiteTitle          String             @default("")
  websiteDescription    String             @default("")
  heroEyebrow           String             @default("")
  heroHeading           String             @default("")
  heroDescription       String             @default("")
  heroPrimaryCtaLabel   String             @default("")
  heroSecondaryCtaLabel String             @default("")
  featuredEyebrow       String             @default("")
  featuredHeading       String             @default("")
  featuredDescription   String             @default("")
  featuredCtaLabel      String             @default("")
  amenitiesEyebrow      String             @default("")
  amenitiesHeading      String             @default("")
  amenitiesDescription  String             @default("")
  aboutEyebrow          String             @default("")
  aboutHeading          String             @default("")
  aboutBodyPrimary      String             @default("")
  aboutBodySecondary    String             @default("")
  aboutImageCaption     String             @default("")
  aboutImageUrl         String?
  aboutImagePublicId    String?
  aboutImageAlt         String             @default("")
  roomsEyebrow          String             @default("")
  roomsHeading          String             @default("")
  roomsDescription      String             @default("")
  footerEyebrow         String             @default("")
  footerHeading         String             @default("")
  footerCtaLabel        String             @default("")
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  heroImages            WebsiteHeroImage[]
  facilities            WebsiteFacility[]
}

model WebsiteHeroImage {
  id              String   @id @default(cuid())
  imageUrl        String
  storagePublicId String?
  displayOrder    Int
  alternativeText String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  websiteContentId String
  websiteContent   WebsiteContent @relation(fields: [websiteContentId], references: [id], onDelete: Cascade)

  @@unique([websiteContentId, displayOrder])
  @@index([websiteContentId])
}

model WebsiteFacility {
  id           String   @id @default(cuid())
  title        String
  description  String
  iconKey      String
  displayOrder Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  websiteContentId String
  websiteContent   WebsiteContent @relation(fields: [websiteContentId], references: [id], onDelete: Cascade)

  @@unique([websiteContentId, displayOrder])
  @@index([websiteContentId])
}

model DemoRequest {
  id              String   @id @default(cuid())
  fullName        String
  workEmail       String
  phoneNumber     String
  hotelName       String
  hotelLocation   String
  numberOfRooms   Int
  role            String
  additionalNotes String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([workEmail])
  @@index([createdAt])
  @@map("demo_requests")
}
